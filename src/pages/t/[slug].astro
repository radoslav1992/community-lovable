---
import Base from '../../layouts/Base.astro';
import LovableBadge from '../../components/LovableBadge.astro';
import CommentEditor from '../../components/CommentEditor.astro';
import { AUTHOR_LOVABLE_SQL } from '../../lib/lovable';
import { tagStyle, timeAgo, initials, avatarGradient, parseDbDate } from '../../lib/format';
import { renderMarkdown, plainText } from '../../lib/markdown';
import { commentFeatures } from '../../lib/schema';

const db = Astro.locals.runtime.env.DB;
const user = Astro.locals.user;
const { slug } = Astro.params;

const post = await db
  .prepare(
    `SELECT p.id, p.tag, p.title, p.slug, p.excerpt, p.body, p.created_at, p.hidden,
      u.name AS author_name, u.username AS author_username, ${AUTHOR_LOVABLE_SQL},
      p.base_votes + (SELECT COUNT(*) FROM votes v WHERE v.post_id = p.id) AS votes,
      EXISTS(SELECT 1 FROM votes v2 WHERE v2.post_id = p.id AND v2.user_id = ?2) AS voted
    FROM posts p JOIN users u ON u.id = p.user_id
    WHERE p.slug = ?1`
  )
  .bind(slug, user?.id ?? 0)
  .first<any>();

if (!post || (post.hidden && user?.role !== 'admin')) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const features = await commentFeatures(db);
// `?2` only exists in the query when comment votes do, so bind it conditionally.
const voteColumns = features.votes
  ? `(SELECT COUNT(*) FROM comment_votes cv WHERE cv.comment_id = c.id) AS votes,
     EXISTS(SELECT 1 FROM comment_votes cv2 WHERE cv2.comment_id = c.id AND cv2.user_id = ?2) AS voted`
  : '0 AS votes, 0 AS voted';
const comments = (
  await db
    .prepare(
      `SELECT c.id, c.user_id, ${features.replies ? 'c.parent_id' : 'NULL AS parent_id'}, c.body, c.created_at,
              ${features.deletes ? 'c.deleted_at' : 'NULL AS deleted_at'},
              u.name AS author_name, u.username AS author_username, ${AUTHOR_LOVABLE_SQL},
              ${voteColumns}
       FROM comments c JOIN users u ON u.id = c.user_id
       WHERE c.post_id = ?1 ORDER BY c.created_at ASC`
    )
    .bind(...(features.votes ? [post.id, user?.id ?? 0] : [post.id]))
    .all<any>()
).results;

const commentByParent = new Map<number | null, any[]>();
for (const comment of comments) {
  const parentId = comment.parent_id ?? null;
  const siblings = commentByParent.get(parentId) ?? [];
  siblings.push(comment);
  commentByParent.set(parentId, siblings);
}

// Best-voted discussion first, so the most useful answer sits right under the
// post; replies stay in the order they were written.
const roots = [...(commentByParent.get(null) ?? [])].sort(
  (a, b) => Number(b.votes) - Number(a.votes) || String(a.created_at).localeCompare(String(b.created_at))
);

const threadedComments: any[] = [];
const appendComment = (comment: any, depth: number) => {
  threadedComments.push({ ...comment, depth });
  for (const reply of commentByParent.get(comment.id) ?? []) appendComment(reply, depth + 1);
};
for (const root of roots) appendComment(root, 0);

// Highlight the top comment only when the vote actually says something.
const topCommentId =
  features.votes && roots.length > 1 && Number(roots[0]?.votes) > 0 && !roots[0]?.deleted_at
    ? Number(roots[0]!.id)
    : null;

const visibleCount = comments.filter((c: any) => !c.deleted_at).length;
const canDelete = (comment: any) =>
  !!user && !comment.deleted_at && (comment.user_id === user.id || user.role === 'admin' || user.role === 'moderator');

const error = Astro.url.searchParams.get('greshka');
const deleted = Astro.url.searchParams.get('iztrito') === '1';
const reported = Astro.url.searchParams.get('dokladvano') === '1';
const REPORT_REASONS = ['Спам / реклама', 'Неуважително отношение', 'Подвеждащо съдържание', 'Друго'];
const description = (post.excerpt || post.body).slice(0, 160);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DiscussionForumPosting',
    headline: post.title,
    text: post.body,
    url: `https://communitylovable.bg/t/${post.slug}`,
    datePublished: parseDbDate(post.created_at).toISOString(),
    author: { '@type': 'Person', name: post.author_name },
    inLanguage: 'bg',
    interactionStatistic: [
      { '@type': 'InteractionCounter', interactionType: { '@type': 'LikeAction' }, userInteractionCount: post.votes },
      { '@type': 'InteractionCounter', interactionType: { '@type': 'CommentAction' }, userInteractionCount: visibleCount },
    ],
    comment: threadedComments
      .filter((c: any) => !c.deleted_at)
      .map((c: any) => ({
        '@type': 'Comment',
        text: plainText(c.body),
        dateCreated: parseDbDate(c.created_at).toISOString(),
        author: { '@type': 'Person', name: c.author_name },
        ...(features.votes
          ? {
              interactionStatistic: {
                '@type': 'InteractionCounter',
                interactionType: { '@type': 'LikeAction' },
                userInteractionCount: Number(c.votes),
              },
            }
          : {}),
      })),
  },
];
---
<Base
  title={`${post.title} — Българска Lovable Общност`}
  description={description}
  canonicalPath={`/t/${post.slug}`}
  ogType="article"
  jsonLd={jsonLd}
  author={post.author_name}
  publishedTime={parseDbDate(post.created_at).toISOString()}
>
  <main>
    <a href="/" class="back">← Назад към емисията</a>

    <article class="card thread">
      <div><span class="tag" style={tagStyle(post.tag)}>{post.tag}</span></div>
      <h1>{post.title}</h1>
      <div class="meta">
        <a href={`/u/${post.author_username}`} class="author">{post.author_name}</a>
        <LovableBadge verified={post.author_lovable} rank={post.author_lovable_rank} edits={post.author_lovable_edits} />
        <time datetime={parseDbDate(post.created_at).toISOString()}>{timeAgo(post.created_at)}</time>
      </div>
      <p class="body">{post.body}</p>
      <div class="actions" data-vote-scope>
        <form method="post" action="/api/vote" data-vote>
          <input type="hidden" name="post_id" value={post.id} />
          <input type="hidden" name="back" value={`/t/${post.slug}`} />
          <button type="submit" class:list={['vote-chip', { voted: !!post.voted }]}>
            ▲ <span data-vote-count>{post.votes}</span>
          </button>
        </form>
        <span class="count">{visibleCount} коментара</span>
        <span class="flex-spacer"></span>
        {user && (
          <details class="report menu">
            <summary>⚑ Докладвай</summary>
            <form method="post" action="/api/report" class="report-form">
              <input type="hidden" name="post_id" value={post.id} />
              <select name="reason" class="input report-select">
                {REPORT_REASONS.map((r) => <option value={r}>{r}</option>)}
              </select>
              <button type="submit" class="btn btn-danger-outline report-submit">Изпрати доклад</button>
            </form>
          </details>
        )}
      </div>
      {reported && <div class="notice notice-ok reported">Благодарим — докладът е изпратен към модераторите.</div>}
    </article>

    <h2 id="komentari">Коментари</h2>

    {deleted && <div class="notice notice-ok">Коментарът е изтрит.</div>}
    {error === 'neotorizirano' && <div class="notice notice-error">Можеш да изтриваш само собствените си коментари.</div>}
    {error === 'iztrivane' && <div class="notice notice-error">Коментарът не може да бъде изтрит в момента.</div>}
    {error === 'blokiran' && <div class="notice notice-error">Профилът ти е блокиран и не може да коментира.</div>}

    {threadedComments.map((c: any, i: number) => (
      <article
        id={`comment-${c.id}`}
        class:list={[
          'card',
          'comment',
          { 'is-reply': c.depth > 0, 'is-top': c.id === topCommentId, 'is-deleted': !!c.deleted_at },
        ]}
        style={`--depth:${Math.min(c.depth, 6)}`}
      >
        {c.deleted_at ? (
          <div class="avatar c-avatar ghost">×</div>
        ) : (
          <div class="avatar c-avatar" style={`background:${avatarGradient(i)}`}>{initials(c.author_name)}</div>
        )}
        <div class="comment-main">
          {c.id === topCommentId && <span class="top-badge">★ Топ коментар</span>}
          {c.deleted_at ? (
            <>
              <div class="c-head"><span class="c-time">Коментарът е изтрит</span></div>
              <p class="tombstone">Този коментар беше премахнат от автора си.</p>
            </>
          ) : (
            <>
              <div class="c-head">
                <a href={`/u/${c.author_username}`} class="c-author">{c.author_name}</a>
                <LovableBadge verified={c.author_lovable} rank={c.author_lovable_rank} edits={c.author_lovable_edits} />
                <time class="c-time" datetime={parseDbDate(c.created_at).toISOString()}>{timeAgo(c.created_at)}</time>
              </div>
              <div class="c-body md" set:html={renderMarkdown(c.body)} />
              <div class="c-actions" data-vote-scope>
                {features.votes && (
                  <form method="post" action="/api/comments/vote" data-vote>
                    <input type="hidden" name="comment_id" value={c.id} />
                    <input type="hidden" name="back" value={`/t/${post.slug}#comment-${c.id}`} />
                    <button
                      type="submit"
                      class:list={['c-vote', { voted: !!c.voted }]}
                      title="Гласувай за коментара"
                      aria-label="Гласувай за коментара"
                    >
                      ▲ <span data-vote-count>{c.votes}</span>
                    </button>
                  </form>
                )}
                {canDelete(c) && (
                  <form
                    method="post"
                    action="/api/comments/delete"
                    data-confirm="Сигурен/на ли си, че искаш да изтриеш този коментар?"
                  >
                    <input type="hidden" name="comment_id" value={c.id} />
                    <button type="submit" class="c-action danger">Изтрий</button>
                  </form>
                )}
                {user && (
                  <details class="inline-reply" id={`reply-${c.id}`}>
                    <summary class="c-action">Отговори</summary>
                    <CommentEditor
                      postId={post.id}
                      slug={post.slug}
                      parentId={c.id}
                      placeholder={`Отговор към ${c.author_name}…`}
                      submitLabel="Отговори"
                      compact={true}
                    />
                  </details>
                )}
              </div>
            </>
          )}
        </div>
      </article>
    ))}
    {comments.length === 0 && <div class="card no-comments">Все още няма коментари — започни дискусията!</div>}

    {user ? (
      <CommentEditor postId={post.id} slug={post.slug} />
    ) : (
      <div class="notice notice-pink">
        <a href="/vhod" class="login-link">Влез в профила си</a>, за да се включиш в дискусията.
      </div>
    )}
  </main>
</Base>

<script src="../../scripts/vote.ts"></script>
<script src="../../scripts/comments.ts"></script>

<style>
  main {
    max-width: 760px; margin: 0 auto; padding: 28px 24px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .back {
    align-self: flex-start; color: var(--muted); font-weight: 700;
    font-size: 14px; padding: 4px 0;
  }
  .back:hover { color: var(--accent); }
  .thread { border-radius: 18px; padding: 26px; }
  .thread > div:first-child { margin-bottom: 10px; }
  h1 { margin: 0 0 10px; font-size: 26px; font-weight: 800; line-height: 1.25; letter-spacing: -0.01em; }
  .meta { display: flex; gap: 14px; font-size: 13px; color: var(--faint); font-weight: 600; margin-bottom: 16px; }
  .author { color: var(--ink-body); }
  .author:hover { color: var(--accent); }
  .body { margin: 0; font-size: 16px; line-height: 1.65; color: var(--ink-soft); white-space: pre-line; }
  .actions { display: flex; gap: 10px; margin-top: 20px; align-items: center; }
  .vote-chip {
    padding: 8px 16px; border-radius: 99px; cursor: pointer; font-size: 14px; font-weight: 800;
    border: 1px solid var(--border-input); color: var(--ink-body); background: #fff;
  }
  .vote-chip:hover { border-color: var(--accent); }
  .vote-chip.voted { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .count { font-size: 13px; color: var(--faint); font-weight: 600; }
  .flex-spacer { flex: 1; }
  .report { position: relative; }
  .report > summary {
    font-size: 13px; color: var(--faint); font-weight: 700; padding: 4px 0;
  }
  .report > summary:hover { color: var(--danger); }
  .report-form {
    position: absolute; right: 0; top: 30px; z-index: 10; width: 240px;
    background: #fff; border: 1px solid var(--border); border-radius: 14px;
    box-shadow: 0 12px 32px rgba(27, 27, 27, 0.12); padding: 12px;
    display: flex; flex-direction: column; gap: 10px; animation: fadeUp 0.15s ease;
  }
  .report-select { font-size: 14px; padding: 9px 12px; }
  .report-submit { font-size: 13px; padding: 8px; }
  .reported { margin-top: 14px; }
  h2 { margin: 8px 0 0; font-size: 16px; font-weight: 800; color: var(--ink-body); }
  .comment { padding: 16px 18px; display: flex; gap: 14px; margin-left: calc(var(--depth, 0) * 28px); scroll-margin-top: 88px; }
  .comment.is-reply { border-left: 3px solid var(--accent-soft); }
  .comment.is-top { border-color: var(--accent); box-shadow: 0 6px 20px rgba(255, 1, 120, 0.07); }
  .comment.is-deleted { background: transparent; border-style: dashed; }
  .comment-main { flex: 1; min-width: 0; }
  .c-avatar { width: 36px; height: 36px; font-size: 12px; }
  .c-avatar.ghost { background: var(--hover-bg); color: var(--faint); font-size: 16px; }
  .top-badge {
    display: inline-block; margin-bottom: 6px; font-size: 11px; font-weight: 800;
    letter-spacing: 0.04em; padding: 3px 9px; border-radius: 99px;
    background: var(--accent-soft); color: var(--accent);
  }
  .c-head { display: flex; gap: 10px; align-items: baseline; margin-bottom: 4px; flex-wrap: wrap; }
  .c-author { font-weight: 800; font-size: 14px; }
  .c-author:hover { color: var(--accent); }
  .c-time { font-size: 12px; color: var(--faint); font-weight: 600; }
  .tombstone { margin: 0; font-size: 14px; color: var(--faint); font-style: italic; }
  .c-actions { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .c-vote {
    display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
    padding: 4px 11px; border-radius: 99px; font-size: 13px; font-weight: 800;
    border: 1px solid var(--border-input); color: var(--ink-body); background: #fff;
  }
  .c-vote:hover { border-color: var(--accent); }
  .c-vote.voted { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .c-action {
    background: none; border: none; cursor: pointer; padding: 4px 8px;
    font-size: 13px; font-weight: 800; color: var(--accent); border-radius: 8px;
  }
  .c-action:hover { background: var(--accent-soft); }
  .c-action.danger { color: var(--faint); }
  .c-action.danger:hover { background: var(--danger-soft); color: var(--danger); }
  /* Sits inline in the action row while closed, takes the full row when open. */
  .inline-reply[open] { width: 100%; margin-top: 4px; }
  .inline-reply > summary { list-style: none; cursor: pointer; }
  .inline-reply > summary::-webkit-details-marker { display: none; }
  .inline-reply[open] > summary { color: var(--muted); margin-bottom: 6px; }
  .no-comments { padding: 18px; font-size: 14px; color: var(--faint); font-weight: 600; }
  .login-link { text-decoration: underline; }
</style>
